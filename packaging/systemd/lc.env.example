# /etc/default/lc - configuration for the lc systemd service
# Install: sudo cp packaging/systemd/lc.env.example /etc/default/lc && edit it.
# Protect: sudo chown root:lc /etc/default/lc && sudo chmod 640 /etc/default/lc

LC_ADDRESS=0.0.0.0:9000
LC_DATA_DIR=/var/lib/lc

# Root credentials (generate with: openssl rand -hex 32)
LC_ACCESS_KEY=change-me
LC_SECRET_KEY=change-me

# Optional TLS (leave empty for plain HTTP)
LC_TLS_CERT=
LC_TLS_KEY=
